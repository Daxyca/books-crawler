# MongoDB
MONGODB_URL="mongodb://admin:Password123@localhost:27017"
MONGODB_USER=admin
MONGODB_PASS=Password123
MONGODB_PORT=27017
MONGODB_DB_NAME=books_db

# Mongo Express
ME_USER=meuser
ME_PASS=mepassword

# Crawler
BASE_URL=https://books.toscrape.com
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=2

# Scheduler
SCHEDULER_HOUR=2
SCHEDULER_MINUTE=0

# API
APP_HOST=0.0.0.0
APP_PORT=8000
API_KEY="your_secret_api_key"
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600
